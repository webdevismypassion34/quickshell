{
  "targets": [
    {
      "template": "kitty.conf",
      "target": "%C/kitty/themes/Quickshell.conf",
      "posthook": "kitty +kitten themes --reload-in=all Quickshell"
    },
    {
      "template": "vesktop.css",
      "target": "%C/vesktop/themes/Quickshell.css",
      "posthook": "true"
    },
    {
      "template": "librewolf.css",
      "target": "%C/librewolf/librewolf/h7md6foa.default-default/chrome/userChrome.css",
      "posthook": "true"
    },
    {
      "template": "hyprland.lua",
      "target": "%C/hypr/modules/quickshell.lua",
      "posthook": "hyprctl reload"
    },
    {
      "template": "userstyle.css",
      "target": "%C/librewolf/librewolf/h7md6foa.default-default/chrome/userContent.css",
      "posthook": "true"
    }
  ]
}
